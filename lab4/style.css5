/* Basic Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background-color: #f4f4f9;
    color: #333;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
}

/* Header */
.header {
    background-color: #2c3e50;
    color: white;
    text-align: center;
    padding: 20px;
}

/* Navigation Bar (Flexbox) */
.navbar {
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #34495e;
    gap: 20px;
    padding: 10px;
}

.navbar a {
    color: white;
    text-decoration: none;
    padding: 8px 16px;
    border-radius: 4px;
}

.navbar a:hover {
    background-color: #1abc9c;
}

/* Container (Desktop Grid Layout) */
.container {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: 20px;
    max-width: 1200px;
    width: 90%;
    margin: 20px auto;
    flex: 1;
}

/* Sidebar */
.sidebar {
    background-color: #ffffff;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

.sidebar ul {
    list-style: none;
    margin-top: 10px;
}

.sidebar li {
    margin-bottom: 10px;
}

.sidebar a {
    color: #34495e;
    text-decoration: none;
}

/* Main Content */
.main-content {
    background-color: #ffffff;
    padding: 20px;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
}

/* 3 Column Cards Grid */
.card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 15px;
    margin-top: 20px;
}

.card {
    background-color: #ecf0f1;
    padding: 15px;
    border-radius: 6px;
    border-left: 4px solid #1abc9c;
}

/* Footer */
.footer {
    background-color: #2c3e50;
    color: white;
    text-align: center;
    padding: 15px;
    margin-top: auto;
}


/* ==========================================
   ЛАБ 5: RESPONSIVE MEDIA QUERIES
   ========================================== */

/* Tablet & Mobile (Дэлгэцийн өргөн 768px-ээс бага болоход) */
@media (max-width: 768px) {
    
    /* 1. Навигацийн цэсийг босоо болгох */
    .navbar {
        flex-direction: column;
        gap: 10px;
    }

    /* 2. Container-ийг Grid-ээс Flex Column (босоо) болгож өөрчлөх (Sidebar дээрээ, Main доороо) */
    .container {
        display: flex;
        flex-direction: column;
        width: 100%;
        margin: 10px;
        padding: 0 10px;
    }

    .sidebar {
        width: 100%;
    }

    /* 3. Картуудыг 3 баганаас 1 багана болгож босоо байрлуулах */
    .card-grid {
        grid-template-columns: 1fr;
    }
}